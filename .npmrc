# pnpm with strict isolation hides root devDeps from packages that
# need to import them at runtime via dynamic resolution (e.g.
# semantic-release loading semantic-release-monorepo via `extends:`
# in .releaserc, which uses importFrom that walks the package's own
# __dirname upward — and lands in pnpm's virtual store, missing
# sibling root devDeps).
#
# `shamefully-hoist` reverts to npm-style flat node_modules layout
# at the root, fixing dynamic plugin loading for tools like
# semantic-release. Documented downside: tightens dependency
# coupling, which we accept in exchange for working CI.
shamefully-hoist=true
