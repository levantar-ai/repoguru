{
  "name": "repoguru-desktop",
  "version": "0.1.0",
  "description": "RepoGuru Desktop — DevSecOps platform for git repository analysis",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:renderer": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "package": "electron-builder --publish never",
    "package:mac": "electron-builder --mac --publish never",
    "package:win": "electron-builder --win --publish never",
    "package:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "@repoguru/core": "workspace:*",
    "@repoguru/desktop-adapter": "workspace:*",
    "@repoguru/ui": "workspace:*",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "electron-updater": "^6.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "playwright": "^1.58.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "author": {
    "name": "RepoGuru",
    "email": "noreply@levantar.ai"
  },
  "license": "MIT",
  "homepage": "https://github.com/levantar-ai/repoguru-unified"
}
